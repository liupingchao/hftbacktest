            "Comment": "0726T068 verify admin no-order preflight artifact",
            "ExpiresAfter": "2026-07-26T17:42:38.395000+08:00",
            "Parameters": {
                "commands": [
                    "set -eu",
                    "repo=/home/admin/hftbacktest-cross-exchange-0726T068",
                    "out=/home/admin/hftbacktest-cross-exchange-artifacts/0726T068_no_order_preflight_admin",
                    "test -f \"$out/orchestrator_preflight.json\"",
                    "grep -Fq '\"status\": \"pass\"' \"$out/orchestrator_preflight.json\"",
                    "grep -Fq '\"source_commit\": \"8736efb36a0866f2c62c51e4afe4fb590c9ac72b\"' \"$out/orchestrator_preflight.json\"",
                    "grep -Fq '\"remote_repo\": \"/home/admin/hftbacktest-cross-exchange-0726T068\"' \"$out/orchestrator_preflight.json\"",
                    "grep -Fq '\"exact_envelope_profile\": \"two-sided-seeded-dynamic-manager\"' \"$out/orchestrator_preflight.json\"",
                    "grep -Fq '\"credential_file_read\": false' \"$out/orchestrator_preflight.json\"",
                    "grep -Fq '\"watcher_process_started\": false' \"$out/orchestrator_preflight.json\"",
                    "test \"$(stat -c %U:%G \"$repo\")\" = admin:admin",
                    "test \"$(stat -c %U:%G \"$out\")\" = admin:admin",
                    "test \"$(stat -c %U:%G \"$out/orchestrator_preflight.json\")\" = admin:admin",
                    "test \"$(systemctl is-active xemm.service 2>/dev/null || true)\" = inactive",
                    "test -z \"$(pgrep -af 'hyperliquid_tiny_live_m2_public_watcher|cross_exchange_live_remote_orchestrator' | grep -v pgrep || true)\"",
                    "sha256sum \"$out/orchestrator_preflight.json\"",
                    "echo ADMIN_PREFLIGHT_VERIFIED"
                ]
            },
