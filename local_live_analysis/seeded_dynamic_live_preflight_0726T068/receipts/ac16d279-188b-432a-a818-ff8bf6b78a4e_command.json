            "Parameters": {
                "commands": [
                    "set -eu",
                    "echo UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)",
                    "echo HOST=$(hostname)",
                    "echo KERNEL=$(uname -sr)",
                    "timedatectl show -p NTPSynchronized -p TimeUSec -p Timezone 2>/dev/null || true",
                    "df -h / /home /tmp",
                    "free -h",
                    "echo XEMM=$(systemctl is-active xemm.service 2>/dev/null || true)",
                    "echo LIVE_PROCESSES_BEGIN",
                    "pgrep -af \"hyperliquid_tiny_live_m2_public_watcher|cross_exchange_live_remote_orchestrator|cross_exchange_public_multi_distance_dynamic_seed|xemm\" || true",
                    "echo LIVE_PROCESSES_END",
                    "echo LOCK_FILE_BEGIN",
                    "ls -l /tmp/hftbacktest_live_test.lock 2>/dev/null || true",
                    "command -v fuser >/dev/null && fuser /tmp/hftbacktest_live_test.lock 2>/dev/null || true",
                    "echo LOCK_FILE_END",
                    "echo REPOS_BEGIN",
                    "find /home/admin -maxdepth 1 -type d -name \"hftbacktest-cross-exchange*\" -printf \"%f\\n\" | sort",
                    "echo REPOS_END"
                ]
            },
