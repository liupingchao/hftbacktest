  "feature_formulas": {
    "activity_500": "per-segment rolling_sum(activity, 25 checkpoints), current checkpoint included",
    "base_eligible": "ready AND valid_book AND elapsed_from_segment_start_ns >= 30000000000 AND activity_500 >= 44.0 AND finite(ratios_100.trade) AND any finite(ratios_100.depletion, ratios_100.ofi) AND finite(ratios_500.trade) AND any finite(ratios_500.depletion, ratios_500.ofi)",
    "depletion_ratio": "(rolling_sum(ask_depletion)-rolling_sum(bid_depletion))/(rolling_sum(ask_depletion)+rolling_sum(bid_depletion)); NaN iff denominator <= 0",
    "ofi_ratio": "rolling_sum(ofi)/rolling_sum(ofi_abs); NaN iff denominator <= 0",
    "rolling_boundary": "reset at segment change; output NaN until the complete same-segment window count is available; no prefix substitution or cross-segment backfill",
    "rolling_counts": {
      "100ms": 5,
      "500ms": 25
    },
    "segment_start_ts": "minimum ts_ns for the current contiguous segment run",
    "trade_ratio": "rolling_sum(trade_signed)/rolling_sum(trade_total); NaN iff denominator <= 0",
    "trailing_realized_volatility": "sqrt(sum(diff(log(midpoint))^2)) over the 51 checkpoints in [t-1s,t], NaN until all 51 same-segment finite positive midpoint values exist"
  },
